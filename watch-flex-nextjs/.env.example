# Copy to .env.local and fill in. See README.md.
ADMIN_PASSWORD=choose-a-strong-password
SECRET=any-long-random-text

# Email (Gmail app password, Brevo, Zoho...). Without these, emails are printed in the console and saved to outbox.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Watch Flex PK <orders@yourdomain.com>
ADMIN_EMAIL=

# Optional: where the JSON database is stored (default: ./data.json). Point this at a persistent disk in production.
# DATA_FILE=/var/data/watchflex.json
